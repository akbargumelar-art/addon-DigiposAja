NODE_ENV=production
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/agrabudi_digipos
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-this-local-secret
TRANSACTION_MODE=MOCK
ALLOW_LIVE_TRANSACTIONS=false
QUEUE_CONCURRENCY=1
QUEUE_DELAY_MS=1000
MAX_RETRY_ATTEMPTS=2
TRANSACTION_TIMEOUT_MS=30000
MAX_UPLOAD_SIZE_MB=20
MOCK_SCENARIO=success
INTEGRATION_STATUS=NOT_CONFIGURED
WINDOWS_AGENT_URL=
WINDOWS_AGENT_SHARED_SECRET=
